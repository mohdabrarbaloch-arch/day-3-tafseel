# ---- Required -------------------------------------------------------------
# Signing key for JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app refuses to start with the dev default.
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database -------------------------------------------------------------
# Leave unset to use SQLite. On Vercel the default becomes sqlite:////tmp/tafseel.db
# because the filesystem is read-only everywhere else.
# For Postgres: postgresql+psycopg://tafseel:tafseel@localhost:5432/tafseel
DATABASE_URL=

# ---- Runtime --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# ---- Auth -----------------------------------------------------------------
# Minutes a JWT stays valid (1440 = 24 hours)
ACCESS_TOKEN_MINUTES=1440

# ---- Long-context tuning --------------------------------------------------
# Approximate tokens per chunk (~4 chars/token)
CHUNK_SIZE_TOKENS=700
# Overlap carried into the next chunk so a fact on a boundary is not lost
CHUNK_OVERLAP_TOKENS=80
# Hard cap on a single document, in characters (2,000,000 ~ 500k tokens)
MAX_DOCUMENT_CHARS=2000000
# Documents allowed in one analysis pass
MAX_DOCUMENTS_PER_ANALYSIS=12
# Sentences in the final reduced summary
SUMMARY_SENTENCES=7

# ---- Security -------------------------------------------------------------
# Comma-separated allow-list. Never use * in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_ANALYSIS=20/minute
RATE_LIMIT_AUTH=10/minute

# ---- Optional: only if you plug in a hosted model later --------------------
# The default engine is fully local and deterministic. No key is required.
# GEMINI_API_KEY=
